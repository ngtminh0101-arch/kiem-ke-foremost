{
  "hosting": [
    {
      "site": "kiemke-foremost",
      "public": ".",
      "ignore": [
        "firebase.json",
        "README.md",
        ".github/**",
        "**/.*",
        "bakery/**"
      ],
      "redirects": [
        {
          "source": "/bakery",
          "destination": "https://kiemke-bakery.web.app/",
          "type": 301
        },
        {
          "source": "/bakery/**",
          "destination": "https://kiemke-bakery.web.app/",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "**/*.@(html|js)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "site": "kiemke-bakery",
      "public": "bakery",
      "ignore": [
        "**/.*"
      ],
      "headers": [
        {
          "source": "**/*.@(html|js)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ]
}
